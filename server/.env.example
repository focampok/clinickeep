# Plantilla de variables de entorno del servicio de ingesta.
# Copiala a .env (que esta en .gitignore) y pon tu propio token.
# NUNCA subas un token real al repositorio.

INGEST_TOKEN=cambiame-por-un-token-largo

# Ruta de la base SQLite. En local, ./data/ck.db; en Railway, /data/ck.db
# (dentro del volumen, para que la base sobreviva a los redeploys).
DB_PATH=./data/ck.db

# Opcional: origenes permitidos para CORS, separados por coma.
# Vacio = CORS cerrado (solo el propio origen del dashboard).
ALLOWED_ORIGINS=
